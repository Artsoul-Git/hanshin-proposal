def create_project(p):
    # プロジェクト作成
    proj = api("POST", "/api/projects", {
        "name": p["name"],
        "goal": p["goal"],
        "memo": p["memo"],
        "status": p["status"],
    })
    pid = proj["id"]

    # 大タスク
    bt_title, bt_status = p["big"]
    bt = api("POST", f"/api/projects/{pid}/big-task", {"title": bt_title})
    api("PUT", f"/api/tasks/{bt['id']}", {"status": bt_status})

    # 中タスク
    for title, status in p["meds"]:
        t = api("POST", f"/api/projects/{pid}/medium-tasks", {"title": title})
        api("PUT", f"/api/tasks/{t['id']}", {"status": status})

    # 小タスク
    for title, status in p["smalls"]:
        t = api("POST", f"/api/projects/{pid}/small-tasks", {"title": title})
        api("PUT", f"/api/tasks/{t['id']}", {"status": status})

    return pid, p["name"]

print("=== Kai Tasks 一括登録開始 ===")
for i, proj in enumerate(PROJECTS, 1):
    try:
        pid, name = create_project(proj)
        tasks_done = sum(1 for s in proj["smalls"] if s[1]=="done") + \
                     sum(1 for m in proj["meds"] if m[1]=="done") + \
                     (1 if proj["big"][1]=="done" else 0)
        total = 1 + len(proj["meds"]) + len(proj["smalls"])
        print(f"[{i:02d}] ✅ {name}  ID:{pid}  {tasks_done}/{total}完了")
    except Exception as e:
        print(f"[{i:02d}] ❌ {proj['name']}  エラー: {e}")

print("\n=== 完了 ===")
